# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# --- Postgres (docker-compose) ---
POSTGRES_USER=replaygate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=replaygate

# --- API server ---
DATABASE_URL=postgres://replaygate:change-me@localhost:5432/replaygate?sslmode=disable
RG_API_ADDR=:8080

# --- Tests (a separate database, created by docker/initdb) ---
TEST_DATABASE_URL=postgres://replaygate:change-me@localhost:5432/replaygate_test?sslmode=disable

# --- Recorder proxy ---
RG_PROXY_ADDR=:8081
RG_UPSTREAM_URL=http://localhost:9000
RG_API_URL=http://localhost:8080
# Printed once by `make bootstrap`:
RG_PROJECT_ID=
RG_API_KEY=

# --- Replay worker (runs on the CI runner next to the build under test) ---
# One of: baseline_a, baseline_b, candidate
RG_VARIANT=candidate
RG_TARGET_URL=http://localhost:3000
# Authorization header value the target expects, e.g. "Bearer <token>".
# Stays in this process; never uploaded or stored. Leave empty for none.
RG_REPLAY_AUTH=
# Optional: RG_CONCURRENCY=8  RG_REQUEST_TIMEOUT=10s  RG_IDLE_EXIT=30s  RG_WORKER_ID=

# --- Dashboard sign-in (GitHub OAuth). Leave all four empty to disable the dashboard. ---
# Create an OAuth app at https://github.com/settings/developers with the callback URL
#   <RG_PUBLIC_URL>/auth/github/callback
RG_GITHUB_CLIENT_ID=
RG_GITHUB_CLIENT_SECRET=
# At least 32 random bytes:  openssl rand -base64 48
RG_JWT_SECRET=
# The address people type in the browser. For local development with the Vite dev
# server this is http://localhost:5173 (it proxies /v1 and /auth to the API).
RG_PUBLIC_URL=http://localhost:5173
# Optional: RG_DASHBOARD_URL (where to land after sign-in)  RG_SESSION_TTL=24h

# --- replaygate CLI / GitHub Action (CI) ---
# RG_API_URL, RG_PROJECT_ID, RG_API_KEY as above, plus:
RG_BASELINE_URL=http://localhost:3001
RG_CANDIDATE_URL=http://localhost:3002
# Optional: RG_SAMPLE_SIZE=1000  RG_NOISE_LEARNING=true  RG_TIMEOUT=15m
#           RG_DASHBOARD_URL (links the PR comment to the run)  RG_COMMENT=true
#           RG_REPORT_FILE=report.md  RG_COMMIT_SHA  RG_PR_NUMBER
