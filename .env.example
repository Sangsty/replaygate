# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# --- Postgres (docker-compose) ---
POSTGRES_USER=replaygate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=replaygate

# --- API server ---
DATABASE_URL=postgres://replaygate:change-me@localhost:5432/replaygate?sslmode=disable
RG_API_ADDR=:8080

# --- Tests (a separate database, created by docker/initdb) ---
TEST_DATABASE_URL=postgres://replaygate:change-me@localhost:5432/replaygate_test?sslmode=disable

# --- Recorder proxy ---
RG_PROXY_ADDR=:8081
RG_UPSTREAM_URL=http://localhost:9000
RG_API_URL=http://localhost:8080
# Printed once by `make bootstrap`:
RG_PROJECT_ID=
RG_API_KEY=
