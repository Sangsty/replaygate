# Copy to .env.prod on the server and fill in. Never commit the real file
# (.env.prod is git-ignored). Generate secrets on the server, not on a shared screen:
#   openssl rand -hex 24      # POSTGRES_PASSWORD (hex only: it goes into a URL)
#   openssl rand -base64 48   # RG_JWT_SECRET

POSTGRES_PASSWORD=

# What people type in the browser. With no domain, use your server's public IP
# with dashes plus .sslip.io, e.g. 13-232-1-2.sslip.io (free; Caddy fetches the
# HTTPS certificate by itself).
RG_HOST=
RG_PUBLIC_URL=https://13-232-1-2.sslip.io

# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
#   <RG_PUBLIC_URL>/auth/github/callback
# Leave all three empty to run without dashboard sign-in.
RG_GITHUB_CLIENT_ID=
RG_GITHUB_CLIENT_SECRET=
RG_JWT_SECRET=

# Only for a local trial of this stack (see deploy/README.md):
# RG_HOST=http://localhost:8088   RG_HTTP_PORT=8088   RG_HTTPS_PORT=8443
