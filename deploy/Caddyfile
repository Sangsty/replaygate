# RG_HOST is the address people type: a hostname such as 13-232-1-2.sslip.io
# (Caddy then gets a Let's Encrypt certificate by itself), or http://localhost:8088
# for a local trial without TLS.
{$RG_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# The API: JSON, sign-in redirects, health check.
	@api path /v1/* /auth/* /healthz
	handle @api {
		reverse_proxy {$RG_API_UPSTREAM:api:8080}
	}

	# Built files have content hashes in their names, so they can be cached
	# for good; a missing one is a real 404, not the app shell.
	handle /assets/* {
		root * {$RG_WEB_ROOT:/srv/web}
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a dashboard page: serve the app shell and let the
	# router pick the page.
	handle {
		root * {$RG_WEB_ROOT:/srv/web}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
